generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MedicineProduct {
  id             String           @id
  name           String
  genericName    String
  strength       String?
  dosageForm     String?
  route          String?
  category       String
  categoryId     String?
  manufacturer   String?
  registrationNo String?
  gtin           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  categoryRef    MedicineCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches        MedicineBatch[]

  @@index([name])
  @@index([genericName])
  @@index([categoryId])
  @@map("medicine_products")
}

model MedicineBatch {
  id             String          @id
  productId      String
  batchNumber    String
  manufacturedAt DateTime?
  expiryDate     DateTime
  supplierId     String?
  manufacturer   String?
  status         BatchStatus     @default(RELEASED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        MedicineProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks         BatchStock[]

  @@unique([productId, batchNumber])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
  @@map("medicine_batches")
}

model BatchStock {
  id           String             @id
  batchId      String
  locationId   String?
  quantity     Int                @default(0)
  minimum      Int                @default(0)
  unitPrice    Int                @default(0)
  status       StockStatus        @default(OUT_OF_STOCK)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  batch        MedicineBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  location     StorageLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transactions StockTransaction[]
  adjustments  StockAdjustment[]

  @@unique([batchId, locationId])
  @@index([status])
  @@index([locationId])
  @@map("batch_stocks")
}

model Supplier {
  id        String          @id
  name      String          @unique
  status    String          @default("ACTIVE")
  createdAt DateTime        @default(now())
  batches   MedicineBatch[]

  @@map("suppliers")
}

model MedicineCategory {
  id        String           @id
  name      String           @unique
  status    String           @default("ACTIVE")
  createdAt DateTime         @default(now())
  products  MedicineProduct[]

  @@map("medicine_categories")
}

model StorageLocation {
  id        String       @id
  name      String       @unique
  status    String       @default("ACTIVE")
  createdAt DateTime     @default(now())
  stocks    BatchStock[]

  @@map("storage_locations")
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  role         String
  status       String   @default("ACTIVE")
  passwordHash String?
  avatarUrl    String?
  lastLogin    DateTime?
  createdAt    DateTime @default(now())

  @@map("users")
}

model StockTransaction {
  id           String     @id @default(cuid())
  batchStockId String
  type         TransactionType
  quantity     Int
  stockBefore  Int
  stockAfter   Int
  performedBy  String?
  referenceNo  String?
  createdAt    DateTime   @default(now())
  batchStock   BatchStock @relation(fields: [batchStockId], references: [id], onDelete: Cascade)

  @@index([batchStockId, createdAt])
  @@index([createdAt])
  @@map("stock_transactions")
}

model StockAdjustment {
  id           String     @id @default(cuid())
  batchStockId String
  stockBefore  Int
  physicalStock Int
  difference   Int
  reason       String
  performedBy  String?
  createdAt    DateTime   @default(now())
  batchStock   BatchStock @relation(fields: [batchStockId], references: [id], onDelete: Cascade)

  @@index([batchStockId, createdAt])
  @@map("stock_adjustments")
}

enum TransactionType {
  IN
  OUT
}

enum BatchStatus {
  RELEASED
  QUARANTINED
  RECALLED
  EXPIRED
}

enum StockStatus {
  NORMAL
  LOW_STOCK
  OUT_OF_STOCK
}
